# shuiyuan-agent 配置模板
# 复制本文件为 .env 并填入你的配置（.env 已被 .gitignore 忽略，不会提交）

# DeepSeek API（必须）
DEEPSEEK_API_KEY=sk-你的key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# jAccount（可选，用于自动登录教学信息服务网 i.sjtu.edu.cn 查课表/成绩）
# 注意：用户名是登录 my.sjtu.edu.cn 的英文用户名（如 zhangsan），不是学号
# JACCOUNT_USERNAME=你的英文用户名
# JACCOUNT_PASSWORD=你的密码

# 选课社区 course.sjtu.plus（可选，自动登录用）
# 注意：这是选课社区的独立密码，不是 jAccount 密码（用 jAccount 登录后在该站设置的密码）；
# 未配置时回退尝试 JACCOUNT_PASSWORD，若选课社区密码不同会登录失败并提示手动登录
# COURSE_PLUS_PASSWORD=你的选课社区密码

# 可选配置（不填则使用默认值）
# LLM_TIMEOUT=120
# MAX_AGENT_ROUNDS=10
# HISTORY_WINDOW=5
# MEMORY_MAX_CHARS=2000        # 全局长期记忆字数上限（超出截断）
# REQUEST_DELAY=1.0
# SEARCH_LIMIT=10
# READ_BUDGET_CHARS=300000      # read_topic 单次读取字符预算（约 20 万 token，覆盖约 5400 层）
# EST_CHARS_PER_POST=100        # 估算单层平均字符（仅用于深度阅读总字符预估）
# MAX_POSTS_PER_TOPIC=5000      # LLM 显式传 max_posts 时的绝对上限
# MAX_TOPIC_PAGES=300           # 单帖最多翻页数（鲁棒性保护）

# 深度阅读（超长楼总结）配置
# DEEP_READ_BLOCK_CHARS=300000    # 分块时每块字符预算（替代原层数制）
# DEEP_READ_MAX_BLOCKS=200         # 最多处理的块数（超过则截断并提示）
# DEEP_READ_MAX_CHARS_PER_POST=1000  # 单层正文截断字符上限
# DEEP_READ_SUMMARY_CHARS=400      # 每块摘要长度上限（字符）

# 外部链接阅读（read_url）配置
# WEB_READ_CHARS=30000             # read_url 返回正文的字符上限（默认）
# WEB_FETCH_TIMEOUT=15             # 单次网页抓取超时（秒）
# WEB_MAX_RESPONSE_BYTES=5242880   # 响应体大小上限（5MB），防内存耗尽

# 视觉模型（图片理解）配置
# 主模型 deepseek-v4-flash 不支持图片，阅读帖子/网页遇到图片时自动调用此视觉模型
# 将图片内容转为文字描述。未配置 VISION_API_KEY 时图片理解不启用（图片保持占位符）。
# VISION_ENABLED=true              # 图片理解总开关
# VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  # 视觉模型 API 地址（OpenAI 兼容）
# 注：阿里云百炼推荐使用业务空间专属域名以获得更优性能：
#   https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 其中 {WorkspaceId} 为百炼控制台"业务空间详情"中的业务空间 ID
# VISION_API_KEY=sk-你的阿里云百炼Key
# VISION_MODEL=qwen3.7-flash       # 视觉模型名称（多模态）
# VISION_MAX_IMAGES=10             # 单帖/单页最多自动理解的图片数
# VISION_DESCRIPTION_CHARS=200     # 单张图片文字描述的字符上限
